# Copy to `.env` and fill in the providers you use. Never commit the real .env.
# Load with e.g. `set -a; source .env; set +a` before running.

# OpenAI (GPT-4o, o4-mini) and any OpenAI-compatible proxy
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Google Gemini (OpenAI-compatible endpoint or a proxy)
GEMINI_API_KEY=
# GEMINI_BASE_URL=

# Alibaba DashScope (Qwen2.5-VL, QvQ-Max)
DASHSCOPE_API_KEY=
# DASHSCOPE_BASE_URL=

# Zhipu (GLM-4.1V-Thinking)
ZHIPU_API_KEY=

# Moonshot (Kimi-VL)
MOONSHOT_API_KEY=

# xAI (Grok)
XAI_API_KEY=

# InternVL
INTERN_API_KEY=

# Optional overrides
# GAMBIT_DATA_PATH=./data/hades_puzzle.npy
# GAMBIT_JUDGE_MODEL=meta-llama/Llama-Guard-3-8B
# GAMBIT_REFINER_MODEL=gpt-4o-2024-11-20
# GAMBIT_SEARCH_ITERS=5
